<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <UserSecretsId>wuxi-erp-apiservice-secrets</UserSecretsId>
    <!-- 临时：把 Facet 源生成器的输出落盘到 obj/.../generated/，便于排查映射生成是否符合预期（排查完删除） -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\king-v.core\KingV.Core.csproj" />
    <ProjectReference Include="..\Wuxi.Shengshen.Erp.ServiceDefaults\Wuxi.Shengshen.Erp.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Aspire 集成：Redis 客户端（提供 AddRedisClient 扩展方法） -->
    <PackageReference Include="Aspire.StackExchange.Redis" Version="13.4.6" />
    <PackageReference Include="DistributedLock" Version="2.8.3" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.20" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Infrastructure\" />
  </ItemGroup>

</Project>